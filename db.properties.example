# ==============================================================================
# ONLINE PET ADOPTION PLATFORM - DATABASE CONFIGURATION
# ==============================================================================

# Database mode: 'mysql' for MySQL server, or 'h2' for embedded/in-memory mode
db.mode=mysql

# MySQL Configuration
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/pet_adoption_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
db.username=root
db.password=password

# Connection Pool Settings (HikariCP)
db.pool.maximumPoolSize=10
db.pool.minimumIdle=2
db.pool.connectionTimeout=30000
db.pool.idleTimeout=600000
db.pool.maxLifetime=1800000

# Fallback / Embedded H2 Settings (Automatic demo mode if MySQL unavailable)
db.fallback.h2.enabled=true
db.fallback.h2.url=jdbc:h2:mem:pet_adoption_db;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE
